# --- Autenticación (JWT) ---
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=stride-co
JWT_AUDIENCE=stride-co-api
BCRYPT_SALT_ROUNDS=10

# --- Bases de datos ---
# Con "npm run dev" y las bases en Docker se usan estos valores (localhost).
# Con "docker compose up" la API recibe DB_HOST=mysql y MONGO_URI=mongodb://mongo:27017/... automáticamente.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=stride-co
DB_USER=root
DB_PASSWORD=abcd1234
MONGO_URI=mongodb://localhost:27017/stride_co

# --- RBAC ---
# Segundos que la API conserva en memoria la matriz leída de la BD (0 = consultar la BD en cada solicitud)
RBAC_CACHE_TTL_SECONDS=10

# --- Seed (npm run seed) ---
# Contraseña de los usuarios de demostración (admin@, sales@, user@ y user2@stride.co)
SEED_PASSWORD=Passw0rd!
# SEED_DEMO_USERS=false   # omite usuarios, clientes y órdenes de demostración
# SEED_MONGO=false        # omite clientes y órdenes de demostración en MongoDB
